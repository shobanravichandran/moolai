# Copy to .env and fill in. Never commit .env.

# --- FalkorDB ---
# Host ports 6380/3001 because other local FalkorDB projects already use 6379/3000.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_BROWSER_PORT=3001
FALKORDB_PASSWORD=
FALKORDB_IMAGE=falkordb/falkordb:v4.22.1
# One graph per company
MOOLAI_GRAPH=brain_kubernetes
MOOLAI_API_PORT=8020

# --- GitHub (read-only public data) ---
# Fine-grained token with "Public repositories (read-only)", or a classic token with no scopes.
GITHUB_TOKEN=

# --- Claude ---
ANTHROPIC_API_KEY=
MOOLAI_MODEL=claude-opus-5-5
# Local cost ledger (JSONL, relative to the repo root). Leave empty to disable.
USAGE_LEDGER=usage.jsonl
